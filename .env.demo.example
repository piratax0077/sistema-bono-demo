APP_NAME="Sistema de Bonos Demo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bonos-demo.example.cl
DEMO_MODE=true
DEMO_USER_SWITCH_ENABLED=true
REVIEW_DEMO_AUTH_BYPASS=false
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_bonos_demo
DB_USERNAME=bonos_demo
DB_PASSWORD=
PERSONAS_FAST_DB_HOST=127.0.0.1
PERSONAS_FAST_DB_PORT=3306
PERSONAS_FAST_DB_DATABASE=sistema_bonos_demo_personas
PERSONAS_FAST_DB_USERNAME=bonos_demo
PERSONAS_FAST_DB_PASSWORD=
PERSONAS_API_URL=
PERSONAS_API_TOKEN=
PERSONAS_API_TIMEOUT=3
PERSONAS_API_FALLBACK_LOCAL=true
MEDICHILE_DB_HOST=127.0.0.1
MEDICHILE_DB_PORT=3306
MEDICHILE_DB_DATABASE=sistema_bonos_demo_medichile
MEDICHILE_DB_USERNAME=bonos_demo
MEDICHILE_DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@demo.local
MAIL_FROM_NAME="${APP_NAME}"
ALLOW_PUBLIC_REGISTRATION=false
IP_WHITELIST_ENABLED=false
PAYMENT_ALLOW_DEMO=true
TOTEM_REQUIRE_IP=false
