APP_NAME="SDI Salud Digital Integrada"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vouchers.example.cl

PERSONAS_API_URL=http://127.0.0.1:8020

# Agenda Med-SDI (12 es el centro que usa INSI)
MEDSDI_API_URL=http://medsdi.test
MEDSDI_API_TOKEN=
MEDSDI_TOTEM_INTEGRATION_KEY=
MEDSDI_API_LOGIN_USER=
MEDSDI_API_LOGIN_PASS=
MEDSDI_API_PROFESIONAL_LOGIN_USER=
MEDSDI_API_PROFESIONAL_LOGIN_PASS=
MEDSDI_API_ASISTENTE_LOGIN_USER=
MEDSDI_API_ASISTENTE_LOGIN_PASS=
MEDSDI_API_DEFAULT_LUGAR_ID=12
MEDSDI_API_DEFAULT_LUGAR_NOMBRE=Centro médico INSI
MEDSDI_API_BOOKING_ENABLED=true
MEDSDI_API_PAGO_ENABLED=false
PERSONAS_API_TOKEN=
PERSONAS_API_TIMEOUT=3
PERSONAS_API_FALLBACK_LOCAL=true
REVIEW_DEMO_AUTH_BYPASS=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sdi_vouchers
DB_USERNAME=voucher_app
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.cl
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CORS_ALLOWED_ORIGINS=https://totem.example.cl
TOTEM_ORIGIN=https://totem.example.cl
TOTEM_REQUIRE_IP=true
TOTEM_SESSION_MINUTES=30
DEVICE_ENROLLMENT_KEY=
ALLOW_PUBLIC_REGISTRATION=false
IP_WHITELIST_ENABLED=true

PAYMENT_ALLOW_DEMO=false
PAYMENT_WEBHOOK_SECRET=
